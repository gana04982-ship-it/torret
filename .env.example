# ========================================================
# TORRET: BULLETPROOF EMAIL AGENT CONFIGURATION
# ========================================================

# 1. Gmail SMTP & IMAP Credentials
# Primary Gmail address
GMAIL_USER=your_email@gmail.com

# 16-character Google App Password (generate at: https://myaccount.google.com/apppasswords)
# Note: Requires 2-Step Verification enabled on your Google account.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 2. AI Personalization (Optional: OpenAI, Groq, DeepSeek, Local Ollama, etc.)
# If left blank, Torret uses its built-in zero-dependency algorithmic structural generator.
AI_API_KEY=your_ai_api_key_here
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 3. Self-Test Recipient
# Used for safe single-email test dispatches via `npm run test-self`
TEST_RECIPIENT=your_email@gmail.com

# 4. Anti-Spam Human Pacing Guardrails
# Random jitter delay between emails (in seconds)
MIN_DELAY_SECONDS=50
MAX_DELAY_SECONDS=110

# Batch size and coffee break pause settings (simulates real human behavior)
BATCH_SIZE=25
BREAK_MIN_MINUTES=15
BREAK_MAX_MINUTES=20

# 5. Optional Custom Data & Suppression Directory
# Defaults to ./data if left blank
# DATA_DIR=./data
